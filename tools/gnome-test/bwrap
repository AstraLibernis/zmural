#!/bin/bash
# Test-only: this container can't mount devpts, so bwrap's `--dev /dev`
# fails; bind the existing /dev instead (glycin's image sandbox).
args=()
while [ $# -gt 0 ]; do
  if [ "$1" = --dev ]; then args+=(--dev-bind "$2" "$2"); shift 2; continue; fi
  args+=("$1"); shift
done
exec /usr/bin/bwrap "${args[@]}"
